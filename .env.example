# ── Database ──────────────────────────────────────────────
# Postgres connection string (Neon, Vercel Postgres, local Postgres...)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Accounts ──────────────────────────────────────────────
# Sign-up needs this code (required in production; if empty in development anyone can sign up).
INVITE_CODE=
# This email gets the ADMIN role. ADMIN_PASSWORD creates that account during the Vercel build (if it doesn't exist yet).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── AI language model ─────────────────────────────────────
# "mock" = offline deterministic provider (no key needed, limited feedback)
# "anthropic" = Claude via the Anthropic API
AI_PROVIDER="mock"
AI_API_KEY=
AI_MODEL="claude-opus-5-5"

# ── Voice ─────────────────────────────────────────────────
# "browser" uses the Web Speech API / speechSynthesis in the learner's browser
# (audio never reaches our server). "none" disables voice.
SPEECH_TO_TEXT_PROVIDER="browser"
SPEECH_TO_TEXT_API_KEY=
# Human-sounding voices: set TEXT_TO_SPEECH_PROVIDER to "openai" or "elevenlabs"
# and put that service's key in TEXT_TO_SPEECH_API_KEY (falls back to browser voice on error).
TEXT_TO_SPEECH_PROVIDER="browser"
TEXT_TO_SPEECH_API_KEY=
# Optional: OpenAI voice name (e.g. "nova") or ElevenLabs voice id
TEXT_TO_SPEECH_VOICE=

# Podcast audio added from a link (Listening → My library) can be transcribed with OpenAI Whisper.
# "none" = learners paste a transcript instead. YouTube captions work without any key.
TRANSCRIPTION_PROVIDER="none"
TRANSCRIPTION_API_KEY=

# ── Email ─────────────────────────────────────────────────
# "console" prints emails (e.g. password reset links) to the server log.
EMAIL_PROVIDER="console"
EMAIL_FROM="BijNederlands <no-reply@example.com>"
