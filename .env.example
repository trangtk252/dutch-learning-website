# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://dutch:dutch@localhost:5432/dutch_dev?schema=public"

# ── Authentication (Better Auth) ──────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated emails that get the ADMIN role on sign-up (blog/content admin).
ADMIN_EMAILS=

# ── AI language model ─────────────────────────────────────
# "mock" = offline deterministic provider (no key needed, limited feedback)
# "anthropic" = Claude via the Anthropic API
AI_PROVIDER="mock"
AI_API_KEY=
AI_MODEL="claude-opus-5-5"

# ── Voice ─────────────────────────────────────────────────
# "browser" uses the Web Speech API / speechSynthesis in the learner's browser
# (audio never reaches our server). "none" disables voice.
SPEECH_TO_TEXT_PROVIDER="browser"
SPEECH_TO_TEXT_API_KEY=
TEXT_TO_SPEECH_PROVIDER="browser"
TEXT_TO_SPEECH_API_KEY=

# ── Email ─────────────────────────────────────────────────
# "console" prints emails (e.g. password reset links) to the server log.
EMAIL_PROVIDER="console"
EMAIL_FROM="Leer Nederlands <no-reply@example.com>"
