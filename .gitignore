# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# test output
/test-results/
/playwright-report/
/.scratch/

# local SQLite database
/prisma/*.db
/prisma/*.db-journal
# these two are needed to run the app, so they must be uploaded when deploying
!/prisma/dictionary.db
!/prisma/production-seed.db

# local backups and download cache (personal data / large)
/prisma/*.backup-*
/prisma/dictionary-source/
